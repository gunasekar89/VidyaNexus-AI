# Copy this file to .env and fill in your values. Never commit .env.

# AI for the tutor, revision plans, practice tests and translations. Fill in ONE option.
# Leave both empty to run with offline sample answers instead of real AI.

# Option 1: Azure OpenAI (for example the KodeKloud Azure playground).
# AZURE_OPENAI_ENDPOINT can be the resource endpoint (https://NAME.openai.azure.com/)
# or the full "Target URI" Azure shows for a deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The deployment name you chose in Azure, and optionally the API version
# (neither is needed when you paste the Target URI, which already has both).
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Longest AI reply in tokens, and how many earlier chat messages the tutor sees.
# Small values suit KodeKloud playground quotas (2,000 tokens/minute); raise them on a bigger quota.
AZURE_OPENAI_MAX_TOKENS=1000
AZURE_OPENAI_HISTORY=6

# Option 2: Claude API key from https://console.anthropic.com (Settings → API keys).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Only needed if both options are filled in: azure or anthropic.
AI_PROVIDER=

# Port the app listens on, on the server (80 = plain http://your-server/).
APP_PORT=80

# Max AI requests per student every 10 minutes (protects your API budget).
AI_REQUESTS_PER_10_MIN=40

# Show the demo accounts on the login page (hidden automatically once their passwords change).
SHOW_DEMO_LOGINS=true

# Set to true only when the site is served over https.
COOKIE_SECURE=false

# Optional: starting passwords for the demo accounts (used only when the database is first created).
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_PASSWORD=
