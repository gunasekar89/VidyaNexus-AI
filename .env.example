# Copy this file to .env and fill in your values. Never commit .env.

# Your Claude API key from https://console.anthropic.com (Settings → API keys).
# Leave it empty to run with offline sample answers instead of real AI.
ANTHROPIC_API_KEY=

# Claude model used by the AI Tutor, revision plans, practice tests and translations.
ANTHROPIC_MODEL=claude-opus-5-5

# Port the app listens on, on the server (80 = plain http://your-server/).
APP_PORT=80

# Max AI requests per student every 10 minutes (protects your API budget).
AI_REQUESTS_PER_10_MIN=40

# Show the demo accounts on the login page (hidden automatically once their passwords change).
SHOW_DEMO_LOGINS=true

# Set to true only when the site is served over https.
COOKIE_SECURE=false

# Optional: starting passwords for the demo accounts (used only when the database is first created).
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_PASSWORD=
